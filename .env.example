# Required in the browser and during build. Use your project's public values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Optional email delivery: set a verified Resend sending address.
RESEND_API_KEY=
RESEND_FROM=ProjectBoard <notifications@your-verified-domain.example>
# Optional AI features. Attempts reserve one of 50 daily slots, UTC.
GROQ_API_KEY=
AI_ENABLED=false
AI_MODEL=openai/gpt-oss-120b
# Enable Google button only after configuring Google in Supabase Auth.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional audio calling. Keep disabled until schema, maintenance and credentials
# are deployed and the scheduled worker's HTTP response is verified.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AUDIO_CALLS_ENABLED=false
GROUP_AUDIO_ENABLED=false
VIDEO_CALLS_ENABLED=false
SCREEN_SHARING_ENABLED=false

# Optional project-wide Storage allowance for the Helios Email maintenance alert.
EMAIL_STORAGE_LIMIT_BYTES=
